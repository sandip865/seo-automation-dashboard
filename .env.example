# =================================================================
# EDGELINK TECHNOLOGY - SEO AUTOMATION DASHBOARD
# Environment Configuration
# =================================================================

# Global Mock Switch (Set to 'true' to run entire pipeline in zero-cost mock mode)
USE_MOCKS=true

# Database (Supabase / Neon Postgres connection string)
# Example: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# For local zero-setup dev without Postgres, a SQLite fallback is automatically supported.
DATABASE_URL="file:./dev.db"

# Redis Queue (Upstash Redis URL for BullMQ)
# Example: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL="redis://localhost:6379"

# AI Analysis Engine (Anthropic Claude API)
# Required for real audit runs; mock fallback is used when USE_MOCKS=true or key is empty
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# External API Integrations (All mocked when USE_MOCKS=true)
GOOGLE_PAGESPEED_API_KEY=""
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=""
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Notification / Delivery (Twilio WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Application
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REPORTS_STORAGE_PATH="./public/reports"
